<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Image Upload</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: #0f0f0f;
            color: #f0f0f0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 16px;
            padding: 40px;
            width: 420px;
            text-align: center;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        }

        h1 {
            font-size: 1.6rem;
            margin-bottom: 8px;
            background: linear-gradient(135deg, #a78bfa, #60a5fa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        p.subtitle {
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 28px;
        }

        .drop-zone {
            border: 2px dashed #3a3a3a;
            border-radius: 12px;
            padding: 30px;
            cursor: pointer;
            transition: border-color 0.2s, background 0.2s;
            margin-bottom: 20px;
            position: relative;
        }

        .drop-zone:hover { border-color: #a78bfa; background: #1f1f2e; }

        .drop-zone input[type="file"] {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
            width: 100%;
        }

        .drop-zone .icon { font-size: 2.5rem; margin-bottom: 8px; }
        .drop-zone .label { color: #888; font-size: 0.9rem; }
        .drop-zone .label span { color: #a78bfa; }

        button[type="submit"] {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 10px;
            background: linear-gradient(135deg, #a78bfa, #60a5fa);
            color: white;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.1s;
        }

        button[type="submit"]:hover { opacity: 0.9; transform: translateY(-1px); }
        button[type="submit"]:active { transform: translateY(0); }

        .error {
            background: #2d1b1b;
            border: 1px solid #7f1d1d;
            color: #fca5a5;
            padding: 10px 14px;
            border-radius: 8px;
            margin-bottom: 16px;
            font-size: 0.9rem;
        }

        .preview {
            margin-top: 24px;
            border-top: 1px solid #2a2a2a;
            padding-top: 24px;
        }

        .preview p {
            color: #888;
            font-size: 0.85rem;
            margin-bottom: 12px;
        }

        .preview img {
            max-width: 100%;
            max-height: 280px;
            border-radius: 10px;
            border: 1px solid #2a2a2a;
            object-fit: contain;
        }

        .file-name {
            color: #a78bfa;
            font-size: 0.85rem;
            margin-top: 8px;
            word-break: break-all;
        }
    </style>
</head>
<body>
    <div class="card">
        <h1>📁 Image Upload</h1>
        <p class="subtitle">Upload JPG, PNG, GIF or WebP · Max 5MB</p>

        <% if (error) { %>
            <div class="error">⚠️ <%= error %></div>
        <% } %>

        <form action="/upload" method="post" enctype="multipart/form-data">
            <div class="drop-zone" id="dropZone">
                <input type="file" name="profilePic" id="fileInput" accept="image/*">
                <div class="icon">🖼️</div>
                <div class="label" id="dropLabel">
                    <span>Click to browse</span> or drag & drop
                </div>
            </div>
            <button type="submit">Upload Image</button>
        </form>

        <% if (uploadedFile) { %>
            <div class="preview">
                <p>✅ Uploaded successfully!</p>
                <img src="<%= uploadedFile %>" alt="Uploaded image">
                <div class="file-name"><%= uploadedFile %></div>
            </div>
        <% } %>
    </div>

    <script>
        const input = document.getElementById('fileInput');
        const label = document.getElementById('dropLabel');

        input.addEventListener('change', () => {
            if (input.files.length > 0) {
                label.innerHTML = `<span>${input.files[0].name}</span>`;
            }
        });
    </script>
</body>
</html>
